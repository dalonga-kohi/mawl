{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["tsconfig.base.json", "tsconfig.json", "biome.json", ".nvmrc"],
  "tasks": {
    "lint": { "dependsOn": ["//#lint:root"] },
    "//#lint:root": {},
    "typecheck": { "dependsOn": ["//#typecheck:root"] },
    "//#typecheck:root": {
      "inputs": ["scripts/**", "tsconfig.json", "vitest.config.ts", "package.json"]
    },
    "test": { "dependsOn": ["//#test:workspace"] },
    "//#test:workspace": {
      "inputs": [
        "scripts/**",
        "package.json",
        "pnpm-workspace.yaml",
        "apps/*/package.json",
        "packages/*/package.json",
        "apps/*/tsconfig.json",
        "packages/*/tsconfig.json",
        "vitest.config.ts"
      ]
    },
    "dev": { "persistent": true, "cache": false }
  }
}
