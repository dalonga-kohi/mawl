# Copy to infra/compose/.env (git ignores it) and fill in.

# Required. Password of the database that compose creates on the first start.
# Generate one with letters and digits only (it goes into a URL):
#   bash:        openssl rand -hex 24
#   PowerShell:  [Convert]::ToHexString([Security.Cryptography.RandomNumberGenerator]::GetBytes(24)).ToLower()
# Changing it later does not change the existing database; run `down -v` to start fresh.
FAIRE_DB_PASSWORD=

# Optional. Extra browser origins that may open the app, comma-separated, e.g. https://faire.example.com
# Same-host and loopback addresses always work.
FAIRE_ALLOWED_ORIGINS=
