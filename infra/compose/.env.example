# Copy to infra/compose/.env (git ignores it) and fill in.

# Required. Password of the database that compose creates on the first start.
# Generate one with letters and digits only (it goes into a URL):
#   bash:        openssl rand -hex 24
#   PowerShell:  [Convert]::ToHexString([Security.Cryptography.RandomNumberGenerator]::GetBytes(24)).ToLower()
# Changing it later does not change the existing database; run `down -v` to start fresh.
MAWL_DB_PASSWORD=

# Optional. Extra browser origins that may open the app, comma-separated, e.g. https://mawl.example.com
# Same-host and loopback addresses always work.
MAWL_ALLOWED_ORIGINS=

# Optional. The owner token the app asks for (32-512 characters: letters, digits, - and _).
# Leave it empty and the server makes one on the first start, prints it once in its log and keeps it
# in the secrets volume. Read it again with:
#   docker compose -f infra/compose/docker-compose.yml exec server cat /secrets/owner-token
MAWL_OWNER_TOKEN=
