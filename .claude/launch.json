{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "apps/web/node_modules/vite/bin/vite.js",
        "apps/web",
        "--config",
        "apps/web/vitest.config.ts",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "fake-server",
      "runtimeExecutable": "pwsh",
      "runtimeArgs": [
        "-NoProfile",
        "-Command",
        "$env:MAWL_E2E='1'; $env:MAWL_PORT='7431'; Set-Location apps/server; node node_modules/tsx/dist/cli.mjs src/e2e/serve.ts"
      ],
      "port": 7431
    },
    {
      "name": "web-fake",
      "runtimeExecutable": "pwsh",
      "runtimeArgs": [
        "-NoProfile",
        "-Command",
        "$env:MAWL_DEV_SERVER='http://127.0.0.1:7431'; node apps/web/node_modules/vite/bin/vite.js apps/web --config apps/web/vitest.config.ts --port 5180 --strictPort"
      ],
      "port": 5180
    }
  ]
}
