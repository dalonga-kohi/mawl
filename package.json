{
  "name": "mawl",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo dev",
    "lint": "turbo lint",
    "lint:root": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "turbo typecheck",
    "typecheck:root": "tsc --noEmit -p .",
    "test": "turbo test",
    "test:workspace": "vitest run --project workspace",
    "test:docker": "vitest run .pg.test.ts postgres.smoke.test.ts",
    "test:e2e": "pnpm --filter @mawl/web e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.5",
    "turbo": "2.11.9",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  }
}
