{
  "name": "@mawl/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "e2e:serve": "tsx src/e2e/serve.ts",
    "build": "node src/build.ts",
    "start": "node dist/server.mjs",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run --passWithNoTests",
    "test:compose": "vitest run --config vitest.compose.config.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@mawl/contracts": "workspace:*",
    "@mawl/core": "workspace:*",
    "@mawl/db": "workspace:*",
    "@orpc/client": "1.16.0",
    "@orpc/contract": "1.16.0",
    "@orpc/server": "1.16.0",
    "drizzle-orm": "0.45.4",
    "graphile-worker": "0.18.0",
    "hono": "4.13.13",
    "libsodium-wrappers": "0.8.4",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "tar": "7.5.22",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@electric-sql/pglite-pgvector": "0.0.12",
    "@mawl/client": "workspace:*",
    "@mawl/testkit": "workspace:*",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2",
    "jose": "6.2.13",
    "tsx": "4.23.15"
  }
}
