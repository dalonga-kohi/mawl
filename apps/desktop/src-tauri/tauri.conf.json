{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mawl",
  "version": "0.0.0",
  "identifier": "app.mawl.desktop",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @mawl/web dev",
    "beforeBuildCommand": "pnpm --filter @mawl/web build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mawl",
        "width": 1280,
        "height": 800,
        "minWidth": 390,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http: https: ws: wss:; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["mawl"]
      }
    }
  }
}
