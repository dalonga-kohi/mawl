{
  "name": "@mawl/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build --config src-tauri/tauri.bundle.conf.json",
    "stage": "node src/bundle/stage.ts",
    "stage:check": "node src/bundle/stage.ts --check",
    "size-budget": "node src/bundle/size-budget.ts",
    "art": "node src/installer-art/render.ts",
    "test:rust": "cargo test --workspace --manifest-path src-tauri/Cargo.toml",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.3",
    "playwright-core": "1.64.1"
  }
}
